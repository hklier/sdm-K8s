{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "sdm-isolated",
    "namespace": "sdm-lab",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
    }
  },
  "spec": {
    "egress": [
      {
        "ports": [
          {
            "port": 53,
            "protocol": "UDP"
          },
          {
            "port": 53,
            "protocol": "TCP"
          }
        ],
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "kube-system"
              }
            },
            "podSelector": {
              "matchLabels": {
                "k8s-app": "kube-dns"
              }
            }
          }
        ]
      }
    ],
    "ingress": [
      {
        "ports": [
          {
            "port": 8443,
            "protocol": "TCP"
          },
          {
            "port": 162,
            "protocol": "UDP"
          }
        ]
      }
    ],
    "podSelector": {
      "matchLabels": {
        "app": "sdm"
      }
    },
    "policyTypes": [
      "Ingress",
      "Egress"
    ]
  }
}
