{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "sdm",
    "namespace": "sdm-lab",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false",
      "metallb.io/loadBalancerIPs": "192.168.0.240"
    }
  },
  "spec": {
    "allocateLoadBalancerNodePorts": true,
    "clusterIP": "10.98.185.153",
    "clusterIPs": [
      "10.98.185.153"
    ],
    "externalTrafficPolicy": "Local",
    "healthCheckNodePort": 30362,
    "internalTrafficPolicy": "Cluster",
    "ipFamilies": [
      "IPv4"
    ],
    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "name": "https",
        "nodePort": 32155,
        "port": 8443,
        "protocol": "TCP",
        "targetPort": "https"
      },
      {
        "name": "snmp-traps",
        "nodePort": 31687,
        "port": 162,
        "protocol": "UDP",
        "targetPort": "snmp-traps"
      },
      {
        "name": "ssh",
        "port": 22,
        "protocol": "TCP",
        "targetPort": "ssh"
      }
    ],
    "selector": {
      "app": "sdm"
    },
    "sessionAffinity": "None",
    "type": "LoadBalancer"
  }
}
