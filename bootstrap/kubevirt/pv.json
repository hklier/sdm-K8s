{
  "apiVersion": "v1",
  "kind": "PersistentVolume",
  "metadata": {
    "name": "sdm-kubevirt-os"
  },
  "spec": {
    "capacity": {
      "storage": "100Gi"
    },
    "volumeMode": "Filesystem",
    "accessModes": [
      "ReadWriteOnce"
    ],
    "persistentVolumeReclaimPolicy": "Retain",
    "storageClassName": "sdm-kubevirt-local",
    "local": {
      "path": "/var/lib/sdm-kubevirt/sdm-os"
    },
    "claimRef": {
      "namespace": "sdm-lab",
      "name": "sdm-os"
    },
    "nodeAffinity": {
      "required": {
        "nodeSelectorTerms": [
          {
            "matchExpressions": [
              {
                "key": "kubernetes.io/hostname",
                "operator": "In",
                "values": [
                  "k8s-worker1"
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
