{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "sdm-device-egress",
    "namespace": "sdm-lab",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
    }
  },
  "spec": {
    "egress": [
      {
        "ports": [
          {
            "port": 161,
            "protocol": "UDP"
          },
          {
            "port": 22,
            "protocol": "TCP"
          },
          {
            "port": 3000,
            "protocol": "TCP"
          },
          {
            "port": 3001,
            "protocol": "TCP"
          }
        ],
        "to": [
          {
            "ipBlock": {
              "cidr": "192.168.0.0/22"
            }
          }
        ]
      }
    ],
    "podSelector": {
      "matchLabels": {
        "app": "sdm"
      }
    },
    "policyTypes": [
      "Egress"
    ]
  }
}
