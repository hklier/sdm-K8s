{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "sdm-lab",
    "namespace": "sdm-lab"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "sdm"
      }
    },
    "policyTypes": [
      "Ingress",
      "Egress"
    ],
    "ingress": [
      {
        "from": [
          {
            "ipBlock": {
              "cidr": "192.168.0.0/22"
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 22
          },
          {
            "protocol": "TCP",
            "port": 8443
          },
          {
            "protocol": "UDP",
            "port": 162
          }
        ]
      }
    ],
    "egress": [
      {
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "kube-system"
              }
            },
            "podSelector": {
              "matchLabels": {
                "k8s-app": "kube-dns"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "UDP",
            "port": 53
          },
          {
            "protocol": "TCP",
            "port": 53
          }
        ]
      },
      {
        "to": [
          {
            "ipBlock": {
              "cidr": "192.168.0.0/22"
            }
          }
        ],
        "ports": [
          {
            "protocol": "UDP",
            "port": 161
          },
          {
            "protocol": "TCP",
            "port": 22
          },
          {
            "protocol": "TCP",
            "port": 3000
          },
          {
            "protocol": "TCP",
            "port": 3001
          }
        ]
      },
      {
        "ports": [
          {
            "protocol": "TCP",
            "port": 443
          },
          {
            "protocol": "UDP",
            "port": 123
          }
        ]
      }
    ]
  }
}
