{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "sdm-data",
    "namespace": "sdm-lab",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
    }
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "resources": {
      "requests": {
        "storage": "50Gi"
      }
    },
    "storageClassName": "sdm-local",
    "volumeMode": "Filesystem",
    "volumeName": "sdm-lab-local"
  }
}
