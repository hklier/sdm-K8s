{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "sdm-headless",
    "namespace": "sdm-lab",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
    }
  },
  "spec": {
    "clusterIP": "None",
    "clusterIPs": [
      "None"
    ],
    "internalTrafficPolicy": "Cluster",
    "ipFamilies": [
      "IPv4"
    ],
    "ipFamilyPolicy": "SingleStack",
    "ports": [
      {
        "name": "https",
        "port": 8443,
        "protocol": "TCP",
        "targetPort": 8443
      }
    ],
    "selector": {
      "app": "sdm"
    },
    "sessionAffinity": "None",
    "type": "ClusterIP"
  }
}
